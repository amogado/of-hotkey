#!/bin/zsh
# of-hotkey-setup — idempotently wire of-hotkey into your Mac.
#
#   of-hotkey-setup              add the managed block to ~/.hammerspoon/init.lua
#   of-hotkey-setup --autostart  also add OmniFocus to your login items
#   of-hotkey-setup --force      rewrite the managed block (resets its bindings)
#
# Safe to run any number of times. The init.lua block is delimited by markers
# and only added when absent; your edits inside it are never touched on re-run.
# The login item is only added if OmniFocus isn't already one.
set -eu

HS_DIR="$HOME/.hammerspoon"
INIT="$HS_DIR/init.lua"
BEGIN="-- >>> of-hotkey (managed) >>>"
END="-- <<< of-hotkey <<<"
FORCE=""
AUTOSTART=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --force) FORCE="1"; shift ;;
    --autostart) AUTOSTART="1"; shift ;;
    *) print -u2 "of-hotkey-setup: unknown arg '$1'"; exit 2 ;;
  esac
done

# --- OmniFocus login item (idempotent) -------------------------------------
if [[ -n "$AUTOSTART" ]]; then
  OF_APP="$(mdfind "kMDItemCFBundleIdentifier == 'com.omnigroup.OmniFocus4'" 2>/dev/null | head -1)"
  [[ -z "$OF_APP" ]] && OF_APP="/Applications/OmniFocus.app"
  osascript - "$OF_APP" <<'APPLESCRIPT'
on run argv
  set ofPath to item 1 of argv
  tell application "System Events"
    if not (exists login item "OmniFocus") then
      make login item at end with properties {path:ofPath, hidden:false}
      log "of-hotkey: OmniFocus added to login items"
    else
      log "of-hotkey: OmniFocus already a login item"
    end if
  end tell
end run
APPLESCRIPT
fi

# --- Hammerspoon managed block (idempotent) --------------------------------
mkdir -p "$HS_DIR"
touch "$INIT"

# Resolve the installed module dir (Apple Silicon or Intel; harmless if brew is
# absent — require() then falls back to a ~/.hammerspoon symlink).
LIB="$(brew --prefix 2>/dev/null || echo /usr/local)/opt/of-hotkey/libexec"

block() {
  cat <<EOF
$BEGIN
package.path = "$LIB/?.lua;" .. package.path
local ok_ofhotkey, ofhotkey = pcall(require, "of-hotkey")
if ok_ofhotkey then
  ofhotkey.setup({
    menubar = true,  -- always-visible OmniFocus menubar anchor
    bindings = {
      -- One line per project. List IDs with:  of-hotkey-projects
      -- { key = "E", project = "PASTE_PROJECT_ID", label = "My Project" },
    },
  })
end
$END
EOF
}

if grep -qF -- "$BEGIN" "$INIT"; then
  if [[ -n "$FORCE" ]]; then
    awk -v b="$BEGIN" -v e="$END" '
      $0==b {skip=1} skip && $0==e {skip=0; next} !skip' "$INIT" > "$INIT.tmp"
    mv "$INIT.tmp" "$INIT"
    printf '\n%s\n' "$(block)" >> "$INIT"
    print "of-hotkey: managed block rewritten in $INIT (bindings reset)."
  else
    print "of-hotkey: block already present in $INIT — nothing to do."
  fi
  exit 0
fi

printf '\n%s\n' "$(block)" >> "$INIT"
print "of-hotkey: added block to $INIT"
print "Edit the bindings inside the block (of-hotkey-projects lists your IDs), then reload Hammerspoon."
